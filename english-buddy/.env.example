# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Turso / libSQL
# Local development can use a file database: TURSO_DATABASE_URL=file:local.db (no token needed)
TURSO_DATABASE_URL=libsql://YOUR_DATABASE.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_TOKEN

# Owner access (maps to the original "owner" account)
APP_ACCESS_CODE=choose-a-long-private-code
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Invite-based registration for additional users (optional).
# Share this code privately; without it, /register stays disabled.
INVITE_CODE=choose-an-invite-code

# OpenAI (server-side only, never exposed to the browser)
OPENAI_API_KEY=sk-YOUR_KEY
OPENAI_MODEL=gpt-5-mini

# Phase 2 — Web Push (generate with: npx web-push generate-vapid-keys)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
