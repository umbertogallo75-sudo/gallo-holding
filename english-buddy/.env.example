# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Turso / libSQL
# Local development can use a file database: TURSO_DATABASE_URL=file:local.db (no token needed)
TURSO_DATABASE_URL=libsql://YOUR_DATABASE.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_TOKEN

# Owner access (maps to the original "owner" account)
APP_ACCESS_CODE=choose-a-long-private-code
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional lock for registration: when set, /register requires this invite code.
# Leave unset for open self-registration.
# INVITE_CODE=choose-an-invite-code

# OpenAI (server-side only, never exposed to the browser)
OPENAI_API_KEY=sk-YOUR_KEY
OPENAI_MODEL=gpt-5

# Voice. Leave unset unless you are deliberately trading quality for cost:
# the defaults in code are the current recommended models.
# VOICE_MODEL=gpt-realtime-2.1
# VOICE_TRANSCRIBE_MODEL=gpt-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# SAM_TTS_VOICE=onyx

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/cron/notifications (sent as "Authorization: Bearer <value>")
CRON_SECRET=choose-a-long-random-secret
