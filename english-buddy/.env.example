# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical server-side origin used by redirects and emails.
# APP_BASE_URL=https://www.execlingo.it
# Set each store URL only after the public listing works without a tester login.
# APP_STORE_URL=https://apps.apple.com/it/app/execlingo/id6800138841
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=it.execlingo.app

# Turso / libSQL
# Local development can use a file database: TURSO_DATABASE_URL=file:local.db (no token needed)
TURSO_DATABASE_URL=libsql://YOUR_DATABASE.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_TOKEN

# Owner access (maps to the original "owner" account)
APP_ACCESS_CODE=choose-a-long-private-code
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Optional comma-separated allowlist for /admin when signing in with Google.
# If omitted, the code accepts only the primary ExecLingo owner email.
# ADMIN_EMAILS=umberto.gallo75@gmail.com

# Optional lock for registration: when set, /register requires this invite code.
# Leave unset for open self-registration.
# INVITE_CODE=choose-an-invite-code

# OpenAI (server-side only, never exposed to the browser)
OPENAI_API_KEY=sk-YOUR_KEY
OPENAI_MODEL=gpt-5.6-sol

# Email. EMAIL_FROM must be an address on a domain verified with the provider,
# or everything lands in spam. EMAIL_REPLY_TO is where a human reply arrives.
# EMAIL_FROM=Sam di ExecLingo <sam@execlingo.it>
# EMAIL_REPLY_TO=ug@vaspitalia.com
# The day the automatic emails start, and the earliest date silence is counted
# from — so nobody lapsed since before the system existed is met with the
# harshest letter first.
# LIFECYCLE_START_AT=2026-09-15

# Voice. Leave unset unless you are deliberately trading quality for cost:
# the defaults in code are the current recommended models.
# VOICE_MODEL=gpt-realtime-2.1
# VOICE_TRANSCRIBE_MODEL=gpt-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# SAM_TTS_VOICE=cedar

# Consent-gated marketing measurement. These identifiers are public and are
# visible in the browser. The LinkedIn signup ID is generated by the individual
# event-specific conversion in Campaign Manager, not by the base Insight Tag.
# NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-00000000000
# NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=your-google-ads-conversion-label
# Set a GA4 override only for Production, or use a separate test stream. When
# unset, the checked-in ExecLingo ID is used only on execlingo.it; localhost and
# Vercel Preview do not send to the production stream by fallback.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID=9624362
# NEXT_PUBLIC_LINKEDIN_SIGNUP_CONVERSION_ID=29840122
# Public website Pixel. The checked-in fallback is enabled only on execlingo.it;
# set an explicit empty value to disable it in a production deployment.
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=DAD8VUBC77UC8FLJL7O0

# Apple In-App Purchase / App Store Server API (server-side only). These values
# come from Users and Access > Integrations > In-App Purchase. Paste the full
# .p8 PEM content into the secret store; do not use an App Store Connect API key.
# APPSTORE_IAP_ISSUER_ID=
# APPSTORE_IAP_KEY_ID=
# APPSTORE_IAP_PRIVATE_KEY=
# Optional; defaults to it.execlingo.app.
# APPSTORE_IAP_BUNDLE_ID=it.execlingo.app
# Keep both purchase UIs off until their live catalogues and server-side
# verification have passed an end-to-end sandbox/internal test.
# APPSTORE_IAP_UI=off
# PLAY_IAP_UI=off
# La UI annuale usa il prodotto it.execlingo.app.annual; il prezzo mostrato
# nell'app arriva dal catalogo StoreKit configurato in App Store Connect.
# Existing deployments may temporarily keep the legacy APPSTORE_* credential
# trio for IAP only. New deployments should use APPSTORE_IAP_* exclusively.

# Marketing reporting APIs (server-side only). Keep the lines commented until
# the matching provider credential is configured in the production secret
# store. Names only are documented here; never commit reporting credentials.

# Existing Google service account shared by the server-side Google adapters.
# Copy client_email and private_key from its JSON key into the production secret
# store; never commit the JSON file or the private key.
# PLAY_SERVICE_ACCOUNT_EMAIL=
# PLAY_SERVICE_ACCOUNT_KEY=
# Stable 32+ character secret used only to bind Play purchases to ExecLingo
# accounts. Generate once before launch and do not rotate with SESSION_SECRET.
# PLAY_ACCOUNT_BINDING_SECRET=

# Google Analytics 4. Use the numeric property that owns the web stream above;
# the automatic collector reads sign_up with an explicit platform=web filter.
# GA4_PROPERTY_ID=

# Google Ads
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional overrides; otherwise the existing GOOGLE_CLIENT_ID/SECRET are reused.
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# Preferred when present. If absent, reporting uses PLAY_SERVICE_ACCOUNT_*
# with the Google Ads scope; grant that identity read-only Ads account access.
# GOOGLE_ADS_REFRESH_TOKEN=
# KPI attribution allowlists: comma-separated numeric IDs. Budget inspection
# remains account-wide even when these are missing.
# GOOGLE_ADS_SEARCH_CAMPAIGN_IDS=
# GOOGLE_ADS_YOUTUBE_CAMPAIGN_IDS=
# App campaigns have advertising_channel_type=MULTI_CHANNEL. Keep their IDs
# and native registration conversion actions separate from the web funnel.
# GOOGLE_ADS_APP_CAMPAIGN_IDS=
# GOOGLE_ADS_REGISTRATION_ACTION_IDS=
# GOOGLE_ADS_APP_REGISTRATION_ACTION_IDS=

# Meta Ads
# META_AD_ACCOUNT_ID=
# META_ACCESS_TOKEN=
# META_GRAPH_API_VERSION=
# META_CAMPAIGN_IDS=

# LinkedIn Ads
# LINKEDIN_AD_ACCOUNT_ID=
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_API_VERSION=
# LINKEDIN_ACCOUNT_CURRENCY=
# LINKEDIN_B2B_CAMPAIGN_IDS=

# App Store Connect Sales and Trends. Use a dedicated Team API key with the
# least-privilege "Sales and Reports" role; an Individual or In-App Purchase key
# cannot download these reports. Paste the complete .p8 PEM into the secret
# store. Configure Apple ID or SKU; Apple ID takes precedence when both exist.
# APPSTORE_REPORTING_ISSUER_ID=
# APPSTORE_REPORTING_KEY_ID=
# APPSTORE_REPORTING_PRIVATE_KEY=
# APPSTORE_REPORTING_VENDOR_NUMBER=
# APPSTORE_REPORTING_APP_APPLE_ID=
# APPSTORE_REPORTING_APP_SKU=

# Google Play downloadable install reports (private Cloud Storage bucket).
# Copy the gs://pubsite_prod_rev_... URI from Play Console > Download reports >
# Statistics. The existing service account above needs the global read-only
# permission "View app information and download bulk reports".
# GOOGLE_PLAY_REPORT_BUCKET=pubsite_prod_rev_0123456789
# Optional; defaults to it.execlingo.app.
# GOOGLE_PLAY_PACKAGE_NAME=it.execlingo.app

# YouTube Analytics
# YOUTUBE_CHANNEL_ID=
# Optional overrides; otherwise the existing GOOGLE_CLIENT_ID/SECRET are reused.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# Email destination for the generated performance report
# MARKETING_REPORT_TO=

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/cron/notifications and /api/cron/marketing-sync
# (sent as "Authorization: Bearer <value>").
CRON_SECRET=choose-a-long-random-secret

# --- Mail inoltrata a Sam ---
# Sottodominio dedicato alla posta in arrivo: i record MX di execlingo.it non
# vengono mai toccati, quindi niente di tutto questo può rompere la posta
# aziendale esistente.
MAIL_INBOUND_DOMAIN=in.execlingo.it
# Segreto condiviso con il servizio che riceve la posta e chiama il webhook.
# Senza, /api/mail/inbound risponde 404 a chiunque.
MAIL_INBOUND_SECRET=
